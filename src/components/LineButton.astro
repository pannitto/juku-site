---
import { site } from '../config/site';
interface Props {
  label?: string;
  primary?: boolean;
  small?: boolean;
}
const { label = '公式LINEで無料相談', primary = false, small = false } = Astro.props;
---

<a
  class:list={['btn', primary ? 'btn-primary' : 'btn-line', { 'btn-small': small }]}
  href={site.lineUrl}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="line-dot" aria-hidden="true"></span>{label}
  <span class="visually-hidden">（LINEが開きます）</span>
</a>
