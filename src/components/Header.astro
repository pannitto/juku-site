---
import { site } from '../config/site';
import LineButton from './LineButton.astro';

const nav = [
  { href: '/service/', label: 'サービス' },
  { href: '/method/', label: '指導の流れ' },
  { href: '/price/', label: '料金' },
  { href: '/tutors/', label: '講師' },
  { href: '/sample/', label: '添削サンプル' },
  { href: '/faq/', label: 'よくある質問' },
];
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">{site.name}</a>

    <nav class="nav-wide" aria-label="メイン">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="header-cta"><LineButton primary small label="LINEで無料相談" /></div>

    <details class="nav-narrow">
      <summary>メニュー</summary>
      <nav aria-label="メイン">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
          <li><a href="/contact/" aria-current={current('/contact/')}>申し込みの流れ</a></li>
          <li><a href={site.lineUrl} target="_blank" rel="noopener noreferrer">公式LINEで無料相談</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
