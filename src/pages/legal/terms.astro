---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import { site, operator } from '../../config/site';

// 雛形です。内容は運営側の業務フローと規約のたたき台に合わせて書き、専門家の確認を受けてから公開してください。
const sections = [
  { h: '適用', body: `この規約は、${operator.tradeName}（以下「当塾」）が提供するオンライン個別指導サービスの利用に適用します。` },
  { h: 'サービスの内容', body: '授業（60分）と、サポート（面談、週間計画と提出物の確認、質問対応、保護者レポート）を提供します。【要確認】' },
  { h: '契約の成立', body: '【要記入】申込、書面の交付、決済の登録のどの時点で契約が成立するか。' },
  { h: '料金と支払い', body: '【要記入】料金の計算方法、締め日、支払日、決済方法、未入金時の扱い。' },
  { h: '欠席と振替', body: '【要記入】欠席の連絡期限、振替の期限と回数、講師都合の場合の扱い。' },
  { h: '休会', body: '【要記入】休会の申込期限、休会中の料金。' },
  { h: 'クーリング・オフ', body: '【要記入】特定商取引法の対象となる契約の場合の、期間と手続き。' },
  { h: '中途解約', body: '【要記入】解約の申込方法と期限、返金、解約手数料（法令の上限を超えない額）。' },
  { h: '禁止事項', body: '【要記入】授業の録画・録音の無断公開、講師との直接の契約・連絡先の交換など。' },
  { h: '個人情報', body: '個人情報は、プライバシーポリシーに従って扱います。' },
  { h: '免責', body: '【要記入】合格を保証しないこと、通信障害の扱いなど。' },
  { h: '規約の変更', body: '【要記入】変更の手続きと通知の方法。' },
  { h: '準拠法と管轄', body: '【要記入】' },
];
---

<Base title="利用規約">
  <PageTitle title="利用規約" />
  <section class="section">
    <div class="wrap prose">
      <p class="draft-note">雛形です。公開前に、すべての【要記入】を埋め、専門家の確認を受けてください。</p>
      {
        sections.map((s, i) => (
          <>
            <h2>第{i + 1}条（{s.h}）</h2>
            <p>{s.body}</p>
          </>
        ))
      }
      <p class="muted">制定日：【要記入】　{site.name}</p>
    </div>
  </section>
</Base>
